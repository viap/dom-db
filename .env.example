# Copy to .env for local development. Production values come from GitHub
# environment secrets (see .github/workflows/deployment.yaml).

MONGO_INITDB_ROOT_USERNAME=change-me
MONGO_INITDB_ROOT_PASSWORD=change-me

# mongo-express (admin UI); keep it unreachable from the internet
ME_CONFIG_BASICAUTH_USERNAME=change-me
ME_CONFIG_BASICAUTH_PASSWORD=change-me
MONGO_EXPRESS_OUTPUT_PORT=8081
